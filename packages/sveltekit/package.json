{
  "name": "@spatial-elements/sveltekit",
  "version": "1.0.0-beta.17",
  "description": "SvelteKit components and navigation for Spatial Elements.",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/LauridBergjohann/spatial-elements.git",
    "directory": "packages/sveltekit"
  },
  "homepage": "https://spatial-elements.bergjohann.com/",
  "bugs": {
    "url": "https://github.com/LauridBergjohann/spatial-elements/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "logo.svg"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs sveltekit && svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "svelte-package -i src -o dist --watch",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@lucide/svelte": "1.77.0",
    "@page-sections/core": "0.6.0",
    "@page-sections/svelte": "0.6.0",
    "@spatial-elements/core": "1.0.0-beta.17"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.4.0",
    "svelte": "^5.59.1",
    "three": "^0.187.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  }
}
