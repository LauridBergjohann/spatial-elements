{
  "name": "@spatial-elements/sveltekit",
  "version": "0.1.0-beta.1",
  "description": "SvelteKit components and navigation for Spatial Elements.",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/LauridBergjohann/spatial-elements.git",
    "directory": "packages/sveltekit"
  },
  "homepage": "https://github.com/LauridBergjohann/spatial-elements#readme",
  "bugs": {
    "url": "https://github.com/LauridBergjohann/spatial-elements/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs sveltekit && svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "svelte-package -i src -o dist --watch",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@spatial-elements/core": "0.1.0-beta.1",
    "lucide-svelte": "^1.0.1"
  },
  "peerDependencies": {
    "svelte": "^5.56.4",
    "@sveltejs/kit": "^2.70.3",
    "three": "^0.185.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  }
}
