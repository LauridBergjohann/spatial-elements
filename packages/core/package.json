{
  "name": "@spatial-elements/core",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent rendering and catalog runtime for Spatial Elements.",
  "license": "MPL-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/LauridBergjohann/spatial-elements.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/LauridBergjohann/spatial-elements#readme",
  "bugs": {
    "url": "https://github.com/LauridBergjohann/spatial-elements/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stage/*": {
      "types": "./dist/stage/*.d.ts",
      "default": "./dist/stage/*.js"
    },
    "./catalog/*": {
      "types": "./dist/catalog/*.d.ts",
      "default": "./dist/catalog/*.js"
    },
    "./spatial-element/*": {
      "types": "./dist/spatial-element/*.d.ts",
      "default": "./dist/spatial-element/*.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package.mjs core && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@3dconnexion/3dconnexionjs": "0.8.1"
  },
  "peerDependencies": {
    "three": "^0.185.1"
  }
}
